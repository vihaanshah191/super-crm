# Database
DATABASE_URL=postgresql+psycopg://super_crm:super_crm@localhost:5432/super_crm

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Auth (placeholder; wire into your existing auth provider before production use)
JWT_SECRET=change-me
JWT_ALGORITHM=HS256

# Scrapling / ingestion
SCRAPLING_DEFAULT_TIMEOUT_SECONDS=30
SCRAPLING_MAX_RESPONSE_BYTES=10485760
INGESTION_DEFAULT_CONCURRENCY=4
# Browser TLS-fingerprint to impersonate via curl_cffi (anti-bot-detection --
# keep as "chrome" for real deployments). Only set this empty if you're
# behind a TLS-intercepting proxy that resets connections on an impersonated
# ClientHello (encountered in this project's own sandboxed dev environment --
# see docs/filesure_data_access.md); never ship that override as a default.
SCRAPLING_IMPERSONATE=chrome

# data.gov.in (MCA Company Master Data access) -- see docs/mca_data_access.md
# Register for a free key at https://www.data.gov.in (Profile -> API key),
# then set it here. Leaving this empty keeps MCA collection disabled via the
# Source.collection_enabled compliance gate, regardless of anything else --
# see app/compliance/source_policy.py. Never commit a real key.
DATA_GOV_IN_API_KEY=
# Full resource URL override. If unset, app/cli/inspect_mca_schema.py and the
# adapter construct one from DATA_GOV_IN_MCA_RESOURCE_ID below.
DATA_GOV_IN_MCA_RESOURCE_URL=
# Resource UUID for the RoC-wise Company Master Data resource, as discovered
# from data.gov.in's own resource page HTML (not yet confirmed via the live
# API -- see docs/mca_data_access.md). Override only if data.gov.in
# republishes this dataset under a different id.
DATA_GOV_IN_MCA_RESOURCE_ID=4dbe5667-7b6b-41d7-82af-211562424d9a

# FileSure (MCA registry data enrichment, api.filesure.in) -- see
# docs/filesure_data_access.md. Get a free sandbox key at
# https://api.filesure.in/portal/signup. The real key must exist ONLY in
# your local .env -- never commit it. FILESURE_COLLECTION_ENABLED must be
# explicitly set to true before any request is made, regardless of whether
# a key is configured -- see app/compliance/source_policy.py.
FILESURE_API_KEY=
FILESURE_ENV=sandbox
FILESURE_COLLECTION_ENABLED=false

# UK Companies House (official company registry) -- see
# docs/companies_house_data_access.md. Register for a free key at
# https://developer.company-information.service.gov.uk (sign in -> create an
# application -> create API client). Free, no cost, rate-limited to 600
# requests per 5 minutes per key. Never commit a real key.
# COMPANIES_HOUSE_COLLECTION_ENABLED must be explicitly set to true before
# any request is made, regardless of whether a key is configured.
COMPANIES_HOUSE_API_KEY=
COMPANIES_HOUSE_COLLECTION_ENABLED=false

# SEC EDGAR (official US public-company filings) -- see
# docs/sec_edgar_data_access.md. No API key needed and free, but SEC's
# fair-access policy requires a real, compliant User-Agent identifying who's
# making the request -- set this to "Your Company Name your-email@domain.com"
# (a real contact address). Leaving this empty keeps SEC EDGAR collection
# disabled, since sending a non-compliant User-Agent gets requests rejected
# by SEC as an "Undeclared Automated Tool" -- see sec.gov/os/webmaster-faq.
SEC_EDGAR_USER_AGENT=

# Logging
LOG_LEVEL=INFO
